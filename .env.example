# PostgreSQL connection string used by the local research store.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_researcher

# PostgreSQL container bootstrap values. Keep DATABASE_URL in sync if these change.
POSTGRES_DB=ai_researcher
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Base URL for the local GROBID service.
GROBID_URL=http://localhost:8070

# Host port published by the local GROBID container. Keep GROBID_URL in sync if this changes.
GROBID_PORT=8070

# CLI subscription backend: claude or codex (never a model name or API key).
LLM_BACKEND_DEFAULT=codex

# Contact address sent in source-adapter User-Agent headers.
CONTACT_EMAIL=researcher@example.com
