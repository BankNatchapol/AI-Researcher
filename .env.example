# PostgreSQL container bootstrap values.
POSTGRES_DB=ai_researcher
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# PostgreSQL connection string used by the local research store.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Base URL for the local GROBID service.
GROBID_URL=http://localhost:8070

# Host port published by the local GROBID container. Keep GROBID_URL in sync if this changes.
GROBID_PORT=8070

# CLI subscription backend: claude or codex (never a model name or API key).
LLM_BACKEND_DEFAULT=codex

# Optional per-job overrides use the normalized, upper-case job name.
# LLM_BACKEND_SUMMARIZE_TREE=claude

# Maximum duration of one model CLI subprocess, in seconds.
LLM_TIMEOUT_SECONDS=120

# Maximum number of model CLI subprocesses allowed to run at once.
LLM_MAX_CONCURRENCY=4

# Contact address sent in source-adapter User-Agent headers.
CONTACT_EMAIL=researcher@example.com

# Minimum delay between consecutive requests, configured independently per source.
ARXIV_MIN_INTERVAL_SECONDS=3
OPENALEX_MIN_INTERVAL_SECONDS=0.1
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1
CROSSREF_MIN_INTERVAL_SECONDS=0.1
REDDIT_MIN_INTERVAL_SECONDS=1
HACKERNEWS_MIN_INTERVAL_SECONDS=0.5

# Optional Reddit OAuth credentials for the discourse adapter. When absent the
# Reddit adapter is skipped with a log line rather than failing the sweep.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Comma-separated subreddit names (without the r/ prefix). Defaults shown.
# REDDIT_SUBREDDITS=QuantumComputing,MachineLearning

# Directory where openly accessible PDFs are stored by numeric paper ID.
STORAGE_DIR=data/papers

# Corpus shortlisting backend: pageindex (default) or postgres_fts.
SHORTLIST_BACKEND=pageindex

# Maximum tree nodes opened across all shortlisted papers for one question.
TRAVERSAL_MAX_NODES=40
