# PostgreSQL container bootstrap values.
POSTGRES_DB=ai_researcher
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# PostgreSQL connection string used by the local research store.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Base URL for the local GROBID service.
GROBID_URL=http://localhost:8070

# Host port published by the local GROBID container. Keep GROBID_URL in sync if this changes.
GROBID_PORT=8070

# CLI subscription backend: claude or codex (never a model name or API key).
LLM_BACKEND_DEFAULT=codex

# Optional per-job overrides use the normalized, upper-case job name.
# LLM_BACKEND_SUMMARIZE_TREE=claude

# Maximum duration of one model CLI subprocess, in seconds.
LLM_TIMEOUT_SECONDS=120

# Maximum number of model CLI subprocesses allowed to run at once.
LLM_MAX_CONCURRENCY=4

# Contact address sent in source-adapter User-Agent headers.
CONTACT_EMAIL=researcher@example.com
